# ClipCatalyst Cloud API — environment template.
# Copy to `.env` next to docker-compose.yml and edit:  cp .env.example .env
# docker compose reads this file to interpolate ${CC_*} in docker-compose.yml,
# and (via env_file) injects AWS_* into the containers for S3 mode.
# Every value below is a SAFE DEFAULT — the stack boots with none of them set.

# ----------------------------------------------------------------------------
# Auth  (READ THIS BEFORE EXPOSING THE API PUBLICLY)
# ----------------------------------------------------------------------------
# CC_API_TOKEN gates the mutating routes (create job / upload / start / file
# download) behind `Authorization: Bearer <token>`. Empty = OPEN, no auth —
# fine for localhost dev, NEVER for a public box. Generate a strong token:
#     openssl rand -hex 32
# then paste it here (and give the same value to the frontend — see DEPLOY.md).
CC_API_TOKEN=

# ----------------------------------------------------------------------------
# Accounts
# ----------------------------------------------------------------------------
# Email+password accounts (register/login/me) are always on; these knobs tune
# them. Signed-in sessions expire this many days after they are issued:
CC_SESSION_TTL_DAYS=30
# Account email delivery: none | console | resend.
#   none    = signup works unverified; password reset is honestly unavailable,
#             and email code sign-in does not exist on this box (503, and the
#             frontend renders no code option at all).
#   console = print would-be emails to the API log, sign-in codes included.
#             DEV ONLY — it is the one place a code appears in plaintext.
#   resend  = deliver via Resend (set the API key below).
CC_MAILER=none
CC_RESEND_API_KEY=
# The From: on every account email. Resend accepts its own onboarding address
# before you have verified a domain, which is why that is the default; point
# it at your own domain once Resend has verified it.
CC_MAIL_FROM=ClipCatalyst <onboarding@resend.dev>
# Email code sign-in (EMAILAUTH.md): type your address, get 6 digits, type
# them back. Needs CC_MAILER above to be something other than none.
# How long one code stays valid:
CC_EMAIL_CODE_TTL_MINUTES=10
# How many codes ONE address may be sent per hour. This is the limit that
# stops a stranger mail-bombing somebody's inbox by typing their address over
# and over; the per-client limiter below (10/min) is a different protection
# and neither substitutes for the other. A code also dies after 5 wrong
# guesses — that cap is not configurable, because 6 digits is only safe while
# it holds.
CC_EMAIL_CODE_PER_HOUR=5
# Sign in with Google (LIBRARY.md Part 1). The OAuth 2.0 *Web application*
# client id from the Google Cloud console (…apps.googleusercontent.com); the
# client SECRET is not needed and must not be set anywhere — this flow only
# verifies ID tokens the browser already holds, it never redeems a code.
# Empty = off: POST /v1/auth/google answers an honest 503 and the frontend
# renders no button. Google is an IDENTITY provider only — posting to TikTok,
# Instagram and YouTube will be separate connections on an existing account.
CC_GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# Publishing connections (PUBLISH.md Part 2)
# ----------------------------------------------------------------------------
# Connecting a channel stores an access token and a refresh token. A refresh
# token is a standing permission to upload to somebody's channel that does not
# expire on its own, so it is ENCRYPTED AT REST with this key and never written
# in the clear. Generate one (keep it out of version control, back it up):
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = off, honestly: POST /v1/connections/{platform}/start answers 503,
# nothing is staged and nothing is stored, and the account page shows the
# platform as unavailable rather than offering a button that cannot work.
#
# Rotating this key does NOT re-encrypt what is already stored: existing
# connections stop decrypting, are dropped the next time they are used, and
# their owners are asked to reconnect (one click). That is the designed
# behaviour, not a failure — but it is a real cost, so rotate deliberately.
CC_TOKEN_KEY=
# The OAuth client the YouTube connection runs as — a *Web application* client
# in the Google Cloud console, WITH a secret (unlike CC_GOOGLE_CLIENT_ID above,
# which only verifies ID tokens and must never have one set). The same project
# can own both. Its authorized redirect URI must be exactly:
#     <CC_PUBLIC_BASE_URL>/v1/connections/youtube/callback
# so CC_PUBLIC_BASE_URL below has to be set to a real https address before a
# connection can be started at all.
#
# Scopes requested: youtube.upload (the point) and youtube.readonly (only to
# read the channel's name for the account page). Both are SENSITIVE: until
# Google's verification completes, the app is capped at 100 users and every
# upload is forced to private. The UI says so — do not remove that line while
# it is still true.
CC_YOUTUBE_CLIENT_ID=
CC_YOUTUBE_CLIENT_SECRET=
# Has Google's review of the youtube.upload scope actually landed?
#
# `off` (the default) is the truthful setting for an unverified app, and it is
# not a preference: Google itself forces every upload from one to `private`, so
# with this off the post sheet offers no visibility choice at all and says why.
# Turning it on WITHOUT the verification does not make posts public — it makes
# the product promise something YouTube then refuses, which is the one failure
# mode this switch exists to prevent. Flip it the day the review comes through.
CC_YOUTUBE_VERIFIED=off

# ----------------------------------------------------------------------------
# Billing (Stripe) — full founder walkthrough in STRIPE-SETUP.md
# ----------------------------------------------------------------------------
# off    = no billing; checkout/portal answer an honest 503, everyone is free.
# stripe = real Stripe subscriptions (fill in every CC_STRIPE_* below).
# fake   = deterministic offline gateway (tests/dev). Webhooks are STILL
#          signature-verified in fake mode — set the webhook secret.
# Anything but `off` REQUIRES CC_API_TOKEN above: without it the job routes
# accept anonymous callers, who have no plan and no quota, so the API refuses
# to start rather than sell limits it cannot enforce (DEPLOY.md §7.1).
CC_BILLING=off
# Secret API key (sk_test_… / sk_live_…). Never logged, never sent to clients.
CC_STRIPE_SECRET_KEY=
# Webhook endpoint signing secret (whsec_…) — POST /v1/billing/webhook rejects
# any payload whose Stripe-Signature does not verify against this.
CC_STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) of the three paid plans; webhooks map price → plan.
CC_STRIPE_PRICE_STARTER=
CC_STRIPE_PRICE_PRO=
CC_STRIPE_PRICE_ENTERPRISE=
# Where Stripe sends the browser back after checkout/portal (no trailing
# slash). GitHub Pages deploy: https://allentackie-ops.github.io/clipcatalyst
CC_FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# Retention
# ----------------------------------------------------------------------------
# Reap each job's row + rendered clips + source this many hours after creation.
CC_JOB_TTL_HOURS=48

# The clip library (LIBRARY.md Part 2) is separate from the job TTL above and
# is NOT configured here: how long a saved clip's FILE is kept comes from the
# owner's plan (free 7 days, starter 30, pro 90, enterprise forever), because
# it is something the pricing page promises. A plan change extends that window
# and never shortens it, and the clip's title, score, hooks and transcript are
# permanent either way — only the video expires.
#
# Largest single clip a browser may save to the library (default 200 MB). The
# container is sniffed from the bytes; only MP4 and WebM are stored.
CC_MAX_CLIP_BYTES=200000000
# Total stored clip FILES one account may hold (default 5 GB). Saving a browser
# clip costs no monthly quota — nothing rendered on our hardware — so this
# ceiling is the only thing between a free account and a free disk. Over it,
# uploads are refused with 402; expired and deleted clips give their bytes back.
CC_LIBRARY_MAX_BYTES=5000000000

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# local = uploads/clips on the ccdata volume, served by the API.
# s3    = presigned PUT uploads + presigned GET clip links (fill in the S3
#         block and AWS credentials below).
CC_STORAGE=local

# S3 mode only (ignored when CC_STORAGE=local):
CC_S3_BUCKET=
CC_S3_PREFIX=clipcatalyst
CC_S3_REGION=us-east-1
# AWS credentials come from the standard boto3 chain. On a box with an IAM
# instance role, leave these UNSET (do not set them empty — an empty key breaks
# instance-role auth). For static keys, uncomment and fill in; env_file injects
# them into both api + worker:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# Transcription (worker)
# ----------------------------------------------------------------------------
# faster-whisper = real model; fake = read a transcript JSON (tests / sandbox).
CC_TRANSCRIBER=faster-whisper
# CPU-safe default. Production GPU: distil-large-v3 / cuda / float16 (DEPLOY.md).
CC_WHISPER_MODEL=base
CC_WHISPER_DEVICE=auto
CC_WHISPER_COMPUTE=default
# Only for CC_TRANSCRIBER=fake — path to a word-timestamped transcript JSON.
CC_FAKE_TRANSCRIPT_PATH=

# ----------------------------------------------------------------------------
# HTTP / frontend
# ----------------------------------------------------------------------------
# Comma-separated allowed browser origins (must include your frontend origin).
CC_CORS_ORIGINS=https://allentackie-ops.github.io,http://localhost:3000,http://localhost:3100
# Absolute base for clip URLs behind a TLS proxy, e.g. https://api.example.com.
# Empty = relative URLs (the SPA resolves them against the API origin) — which
# is fine for clips, and NOT enough for publishing connections: an OAuth
# redirect URI has to be an absolute address the platform's console knows about
# (see CC_TOKEN_KEY above), so leaving this empty keeps every connection off.
CC_PUBLIC_BASE_URL=
# Reverse proxies allowed to speak for their clients: ips or CIDR blocks,
# comma-separated. Only from these peers is the leftmost X-Forwarded-For entry
# read as the real client (the auth rate limiter keys on it). Empty = trust
# nobody — correct when nothing is in front, and see DEPLOY.md §7.2 when
# something is: unset behind a proxy, every caller shares ONE rate-limit
# bucket; trusted too broadly, anyone can forge their way out of it.
# 0.0.0.0/0 and ::/0 trust the whole internet and are refused at startup.
CC_TRUSTED_PROXIES=
# The auth rate limiter (10/min on register, login and checkout) counts in
# Redis — the same CC_REDIS_URL Celery brokers on — under a key that names its
# own minute and expires itself. What it does when Redis is unreachable:
#   off (default) = refuse the attempt. An attempt that cannot be counted is
#                   an attempt that is not limited, and Redis being down means
#                   this box cannot render a clip either, so nothing working
#                   is being broken by refusing.
#   on            = let it through. A brief Redis blip stops turning a real
#                   sign-in into a 429 — and an attacker who can reach Redis
#                   can un-limit login. Choose it knowingly. See DEPLOY.md §7.2.
CC_RATE_LIMIT_FAIL_OPEN=off
# Hard upload cap in bytes (default 2 GB).
CC_MAX_UPLOAD_BYTES=2000000000

# ----------------------------------------------------------------------------
# Render safety
# ----------------------------------------------------------------------------
# Hard ceiling (seconds) on a single ffmpeg render before it is killed.
CC_RENDER_TIMEOUT_S=900

# ----------------------------------------------------------------------------
# Advanced / rarely changed
# ----------------------------------------------------------------------------
# In docker-compose these are fixed inside the containers and are shown here
# only for non-compose runs; setting them in .env does NOT override compose:
#   CC_DATA_DIR=/data          # writable data root (uploads, clips, db, tmp)
#   CC_DB_PATH=/data/jobs.sqlite3
#   CC_REDIS_URL=redis://redis:6379/0
#   CC_QUEUE=redis             # redis | eager (eager runs the pipeline inline)
# ffmpeg/ffprobe resolve from PATH inside the image; override only off-Docker:
#   CC_FFMPEG_BIN=
#   CC_FFPROBE_BIN=
