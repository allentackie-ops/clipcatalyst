# ClipCatalyst Cloud API — environment template.
# Copy to `.env` next to docker-compose.yml and edit:  cp .env.example .env
# docker compose reads this file to interpolate ${CC_*} in docker-compose.yml,
# and (via env_file) injects AWS_* into the containers for S3 mode.
# Every value below is a SAFE DEFAULT — the stack boots with none of them set.

# ----------------------------------------------------------------------------
# Auth  (READ THIS BEFORE EXPOSING THE API PUBLICLY)
# ----------------------------------------------------------------------------
# CC_API_TOKEN gates the mutating routes (create job / upload / start / file
# download) behind `Authorization: Bearer <token>`. Empty = OPEN, no auth —
# fine for localhost dev, NEVER for a public box. Generate a strong token:
#     openssl rand -hex 32
# then paste it here (and give the same value to the frontend — see DEPLOY.md).
CC_API_TOKEN=

# ----------------------------------------------------------------------------
# Retention
# ----------------------------------------------------------------------------
# Reap each job's row + rendered clips + source this many hours after creation.
CC_JOB_TTL_HOURS=48

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# local = uploads/clips on the ccdata volume, served by the API.
# s3    = presigned PUT uploads + presigned GET clip links (fill in the S3
#         block and AWS credentials below).
CC_STORAGE=local

# S3 mode only (ignored when CC_STORAGE=local):
CC_S3_BUCKET=
CC_S3_PREFIX=clipcatalyst
CC_S3_REGION=us-east-1
# AWS credentials come from the standard boto3 chain. On a box with an IAM
# instance role, leave these UNSET (do not set them empty — an empty key breaks
# instance-role auth). For static keys, uncomment and fill in; env_file injects
# them into both api + worker:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# Transcription (worker)
# ----------------------------------------------------------------------------
# faster-whisper = real model; fake = read a transcript JSON (tests / sandbox).
CC_TRANSCRIBER=faster-whisper
# CPU-safe default. Production GPU: distil-large-v3 / cuda / float16 (DEPLOY.md).
CC_WHISPER_MODEL=base
CC_WHISPER_DEVICE=auto
CC_WHISPER_COMPUTE=default
# Only for CC_TRANSCRIBER=fake — path to a word-timestamped transcript JSON.
CC_FAKE_TRANSCRIPT_PATH=

# ----------------------------------------------------------------------------
# HTTP / frontend
# ----------------------------------------------------------------------------
# Comma-separated allowed browser origins (must include your frontend origin).
CC_CORS_ORIGINS=https://allentackie-ops.github.io,http://localhost:3000,http://localhost:3100
# Absolute base for clip URLs behind a TLS proxy, e.g. https://api.example.com.
# Empty = relative URLs (the SPA resolves them against the API origin).
CC_PUBLIC_BASE_URL=
# Hard upload cap in bytes (default 2 GB).
CC_MAX_UPLOAD_BYTES=2000000000

# ----------------------------------------------------------------------------
# Render safety
# ----------------------------------------------------------------------------
# Hard ceiling (seconds) on a single ffmpeg render before it is killed.
CC_RENDER_TIMEOUT_S=900

# ----------------------------------------------------------------------------
# Advanced / rarely changed
# ----------------------------------------------------------------------------
# In docker-compose these are fixed inside the containers and are shown here
# only for non-compose runs; setting them in .env does NOT override compose:
#   CC_DATA_DIR=/data          # writable data root (uploads, clips, db, tmp)
#   CC_DB_PATH=/data/jobs.sqlite3
#   CC_REDIS_URL=redis://redis:6379/0
#   CC_QUEUE=redis             # redis | eager (eager runs the pipeline inline)
# ffmpeg/ffprobe resolve from PATH inside the image; override only off-Docker:
#   CC_FFMPEG_BIN=
#   CC_FFPROBE_BIN=
